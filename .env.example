NODE_ENV=development

# Redis — required for auth, sessions, rate limiting, caching
REDIS_URL=redis://localhost:6379

# Session settings
SESSION_TTL=3600

# Concurrent user limits
MAX_CONCURRENT_USERS=100
MAX_CONCURRENT_CONNECTIONS=1000

# Rate limiting (per IP, per window)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60

# Product cache TTL (seconds)
PRODUCT_CACHE_TTL=60

# Database (replace with real connection string when adding PostgreSQL)
DATABASE_URL=

# Admin metrics endpoint secret — change before deploying to production
METRICS_SECRET=change-me-in-production

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
